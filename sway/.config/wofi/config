# Wofi drun launcher config for Sway.
# Open with Super+d from sway/.config/sway/config.

show=drun
prompt=Search applications
term=alacritty
allow_images=true
insensitive=true
matching=fuzzy
sort_order=alphabetical
gtk_dark=true
hide_scroll=true
no_actions=true
width=720
height=520
location=center
columns=1
lines=12
